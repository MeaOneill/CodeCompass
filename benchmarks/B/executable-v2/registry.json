          },
          "text": " 834  def unique_iter(src, key=None):"
        },
        {
          "unit_id": "task_003__unique_iter",
          "source_span": {
            "snapshot_id": "boltons-4e5faa3d7e40",
            "path": "boltons/iterutils.py",
            "start_line": 851,
            "end_line": 867,
            "content_hash": "47ee7d413a63eb939b50e6da3e73bb94019cbd6f3a7c1c3bd67d803ae391e16b"
          },
          "text": " 851      if not is_iterable(src):\n 852          raise TypeError('expected an iterable, not %r' % type(src))\n 853      if key is None:\n 854          def key_func(x): return x\n 855      elif callable(key):\n 856          key_func = key\n 857      elif isinstance(key, str):\n 858          def key_func(x): return getattr(x, key, x)\n 859      else:\n 860          raise TypeError('\"key\" expected a string or callable, not %r' % key)\n 861      seen = set()\n 862      for i in src:\n 863          k = key_func(i)\n 864          if k not in seen:\n 865              seen.add(k)\n 866              yield i\n 867      return"
        }
