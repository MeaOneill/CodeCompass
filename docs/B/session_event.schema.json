{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "B draft session profile; A 1.0.0 remains authoritative. Cross-event ordering checked by future recorder.",
  "allOf": [
    {
      "$ref": "../../schemas/contracts.schema.json"
    },
    {
      "properties": {
        "object_type": {
          "const": "ExperimentEvent"
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "exit_code": {
                "const": 0
              },
              "error": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "paused"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "resume_from": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "resumed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "resume_from": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "anyOf": [
              {
                "properties": {
                  "exit_code": {
                    "type": "integer",
                    "not": {
                      "const": 0
                    }
                  }
                }
              },
              {
                "properties": {
                  "error": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
